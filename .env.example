# Copie este archivo como .env (local) o cargue estas variables en Railway > Variables
PORT=3000
# Carpeta persistente: en Railway monte un volumen en /data
DATA_DIR=/data
# Usuario administrador inicial (solo se usa si la base está vacía)
ADMIN_USER=admin
ADMIN_PASSWORD=cambie-esta-clave
# Secreto para firmar sesiones (cadena larga aleatoria)
SESSION_SECRET=
# Opcional: activa el agente con IA (sin esta clave se usa el motor local de reglas)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5
# Datos del desarrollador que se muestran en la portada
DEV_NOMBRE=L&R Sinergia
DEV_CARGO=Desarrollador y asesor financiero
DEV_CORREO=luisquispw@gmail.com
DEV_WHATSAPP=70304578
DEV_UBICACION=Cochabamba - Bolivia
DEV_CONTACTO=
